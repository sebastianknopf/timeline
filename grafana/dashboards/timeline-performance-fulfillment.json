        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timeline-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  SUM(nom_total_distance) AS \"Soll\",\r\n  SUM(\r\n    CASE\r\n      WHEN schedule_relationship = 'SCHEDULED' THEN act_total_distance\r\n      WHEN ${act_values_mode} = 1\r\n      AND schedule_relationship = 'UNKNOWN' THEN nom_total_distance\r\n      ELSE 0\r\n    END\r\n  ) AS \"Ist\",\r\n  SUM(nom_total_distance) FILTER (\r\n    WHERE\r\n      trips.schedule_relationship IN ('CANCELLED')\r\n  ) AS \"Ausfall\"\r\nFROM\r\n  dim_trips trips\r\n  INNER JOIN dim_routes routes ON routes.route_id = trips.route_id\r\nWHERE\r\n  trips.operation_day_date BETWEEN '${__from:date:YYYY-MM-DD}' :: DATE\r\n  AND '${__to:date:YYYY-MM-DD}' :: DATE\r\n  AND trips.instance_id IN (${instance:sqlstring})\r\n  AND COALESCE(\r\n    trips.concessionaire_name,\r\n    routes.concessionaire_name\r\n  ) IN (${concessionaire:sqlstring})\r\n  AND routes.route_name IN (${route:sqlstring})",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
