      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timeline-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH trip_delays AS (\r\n  SELECT\r\n    instance_id,\r\n    operation_day_date,\r\n    trip_id,\r\n    MIN(\r\n      EXTRACT(\r\n        EPOCH\r\n        FROM\r\n          (\r\n            COALESCE(act_arrival_time, act_departure_time) - COALESCE(nom_arrival_time, nom_departure_time)\r\n          )\r\n      ) / 60.0\r\n    ) AS min_delay_minutes,\r\n    MAX(\r\n      EXTRACT(\r\n        EPOCH\r\n        FROM\r\n          (\r\n            COALESCE(act_arrival_time, act_departure_time) - COALESCE(nom_arrival_time, nom_departure_time)\r\n          )\r\n      ) / 60.0\r\n    ) AS max_delay_minutes\r\n  FROM\r\n    fact_stop_times\r\n  WHERE\r\n    operation_day_date BETWEEN '${__from:date:YYYY-MM-DD}' :: DATE\r\n    AND '${__to:date:YYYY-MM-DD}' :: DATE\r\n    AND instance_id IN (${instance:sqlstring})\r\n  GROUP BY\r\n    instance_id,\r\n    operation_day_date,\r\n    trip_id\r\n)\r\nSELECT\r\n  trips.operation_day_date AS \"Betriebstag\",\r\n  trips.trip_id AS \"Fahrt-ID\",\r\n  routes.route_name AS \"Linie\",\r\n  COALESCE(\r\n    trips.concessionaire_name,\r\n    routes.concessionaire_name\r\n  ) AS \"Konzessionär\",\r\n  COALESCE(\r\n    trips.operator_name,\r\n    routes.operator_name\r\n  ) AS \"Betreiber\",\r\n  trips.nom_start_time AS \"Abfahrtszeit (Soll)\",\r\n  trips.act_start_time AS \"Abfahrtszeit (Ist)\",\r\n  start_stop.stop_name AS \"Start\",\r\n  trips.nom_end_time AS \"Ankunftszeit (Soll)\",\r\n  trips.act_end_time AS \"Ankunftszeit (Ist)\",\r\n  end_stop.stop_name AS \"Ziel\",\r\n  trips.nom_total_distance AS \"Kilometer (Soll)\",\r\n  trips.act_total_distance AS \"Kilometer (Ist)\",\r\n  EXTRACT(\r\n    EPOCH\r\n    FROM\r\n      (\r\n        trips.nom_end_time - trips.nom_start_time\r\n      )\r\n  ) / 3600.0 AS \"Fahrplanzeit (Soll)\",\r\n  EXTRACT(\r\n    EPOCH\r\n    FROM\r\n      (\r\n        trips.act_end_time - trips.act_start_time\r\n      )\r\n  ) / 3600.0 AS \"Fahrplanzeit (Ist)\",\r\n  trip_delays.min_delay_minutes AS \"Min. Abweichung\",\r\n  trip_delays.max_delay_minutes AS \"Max. Abweichung\",\r\n  trips.schedule_relationship AS \"Status\"\r\nFROM\r\n  dim_trips trips\r\n  INNER JOIN dim_routes routes ON routes.route_id = trips.route_id\r\n  INNER JOIN dim_stops start_stop ON start_stop.stop_id = trips.nom_start_stop_id\r\n  INNER JOIN dim_stops end_stop ON end_stop.stop_id = trips.nom_end_stop_id\r\n  LEFT JOIN trip_delays ON trip_delays.instance_id = trips.instance_id\r\n  AND trip_delays.operation_day_date = trips.operation_day_date\r\n  AND trip_delays.trip_id = trips.trip_id\r\nWHERE\r\n  trips.operation_day_date BETWEEN '${__from:date:YYYY-MM-DD}' :: DATE\r\n  AND '${__to:date:YYYY-MM-DD}' :: DATE\r\n  AND trips.instance_id IN (${instance:sqlstring})\r\n  AND COALESCE(\r\n    trips.concessionaire_name,\r\n    routes.concessionaire_name\r\n  ) IN (${concessionaire:sqlstring})\r\n  AND routes.route_name IN (${route:sqlstring})\r\nORDER BY\r\n  trips.nom_start_time;",
          "refId": "A",
          "sql": {
            "columns": [
              {
