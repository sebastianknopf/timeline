          "rawSql": "SELECT\r\n  stops.stop_name AS \"Haltestelle\",\r\n  stops.stop_lat AS \"Breitengrad\",\r\n  stops.stop_lon AS \"Längengrad\",\r\n  EXTRACT(\r\n      EPOCH\r\n      FROM\r\n        (act_arrival_time - nom_arrival_time)\r\n    ) / 60 AS \"Abweichung\"\r\nFROM\r\n  fact_stop_times stop_times\r\nINNER JOIN\r\n  dim_stops stops ON stops.stop_id = stop_times.stop_id\r\nWHERE\r\n  stop_times.instance_id = ANY(\r\n    STRING_TO_ARRAY(\r\n      REPLACE(REPLACE('${instance_id:raw}', '{', ''), '}', ''),\r\n      ','\r\n    )\r\n  )\r\n  AND stop_times.operation_day_date = to_date('${operation_day_date}', 'DD.MM.YYYY')\r\n  AND stop_times.trip_id = ${trip_id:sqlstring}\r\nORDER BY\r\n  stop_sequence ASC",
          "refId": "A",
          "sql": {
