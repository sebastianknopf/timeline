          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  routes.route_name AS \"Linie\",\r\n  COALESCE(trips.concessionaire_name, routes.concessionaire_name) AS \"Konzessionär\",\r\n  COALESCE(trips.operator_name, routes.operator_name) AS \"Betreiber\"\r\nFROM\r\n  dim_trips trips\r\nINNER JOIN\r\n  dim_routes routes ON routes.route_id = trips.route_id\r\nWHERE\r\n  trips.instance_id = ANY(\r\n    STRING_TO_ARRAY(\r\n      REPLACE(REPLACE('${instance_id:raw}', '{', ''), '}', ''),\r\n      ','\r\n    )\r\n  )\r\n  AND operation_day_date = to_date('${operation_day_date}', 'DD.MM.YYYY')\r\n  AND trip_id = ${trip_id:sqlstring}",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [
                  {
                    "name": "nom_total_distance",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
