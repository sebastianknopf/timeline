          "rawSql": "SELECT\r\n  AVG(EXTRACT(\r\n    EPOCH\r\n    FROM\r\n      (act_arrival_time - nom_arrival_time)\r\n  ) / 60) AS \"Abw. Ankunft\",\r\n  AVG(EXTRACT(\r\n    EPOCH\r\n    FROM\r\n      (act_departure_time - nom_departure_time)\r\n  ) / 60) AS \"Abw. Abfahrt\"\r\nFROM\r\n  fact_stop_times \r\nWHERE\r\n  instance_id = ANY(\r\n    STRING_TO_ARRAY(\r\n      REPLACE(REPLACE('${instance_id:raw}', '{', ''), '}', ''),\r\n      ','\r\n    )\r\n  )\r\n  AND operation_day_date = to_date('${operation_day_date}', 'DD.MM.YYYY')\r\n  AND trip_id = ${trip_id:sqlstring}\r\nGROUP BY\r\n  operation_day_date,\r\n  trip_id",
          "refId": "A",
