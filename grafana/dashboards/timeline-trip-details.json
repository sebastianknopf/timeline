          "rawQuery": true,
          "rawSql": "SELECT\r\n  stops.stop_name AS \"Haltestelle\",\r\n  nom_arrival_time AS \"Ankunftszeit (Soll)\",\r\n  nom_departure_time AS \"Abfahrtszeit (Soll)\",\r\n  act_arrival_time AS \"Ankunftszeit (Ist)\",\r\n  act_departure_time AS \"Abfahrtszeit (Ist)\",\r\n  EXTRACT(\r\n    EPOCH\r\n    FROM\r\n      (act_arrival_time - nom_arrival_time)\r\n  ) / 60 AS \"Abw. Ankunft\",\r\n  EXTRACT(\r\n    EPOCH\r\n    FROM\r\n      (act_departure_time - nom_departure_time)\r\n  ) / 60 AS \"Abw. Abfahrt\",\r\n  distance_from_start AS \"Strecke\",\r\n  schedule_relationship AS \"Status\"\r\nFROM\r\n  fact_stop_times stop_times\r\n  INNER JOIN dim_stops stops ON stops.stop_id = stop_times.stop_id\r\nWHERE\r\n  stop_times.instance_id = ANY(\r\n    STRING_TO_ARRAY(\r\n      REPLACE(REPLACE('${instance_id:raw}', '{', ''), '}', ''),\r\n      ','\r\n    )\r\n  )\r\n  AND stop_times.operation_day_date = to_date('${operation_day_date}', 'DD.MM.YYYY')\r\n  AND stop_times.trip_id = ${trip_id:sqlstring}\r\nORDER BY\r\n  stop_sequence ASC",
