      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timeline-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\r\n  stop_name AS Name,\r\n  stop_lat AS Breitengrad,\r\n  stop_lon AS Längengrad\r\nFROM\r\n  dim_stops\r\nWHERE\r\n  instance_id IN (${instance:sqlstring})\r\n  AND stop_lat <> 0.0\r\n  AND stop_lon <> 0.0",
          "refId": "StopsLayerQuery",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timeline-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\r\n  stops.stop_lat,\r\n  stops.stop_lon,\r\n  AVG(\r\n    GREATEST(\r\n      EXTRACT(\r\n        EPOCH\r\n        FROM\r\n          (act_arrival_time - nom_arrival_time)\r\n      ) / 60,\r\n      EXTRACT(\r\n        EPOCH\r\n        FROM\r\n          (act_departure_time - nom_departure_time)\r\n      ) / 60\r\n    )\r\n  ) AS Verspätung\r\nFROM\r\n  fact_stop_times stop_times\r\n  INNER JOIN dim_stops stops ON stop_times.stop_id = stops.stop_id\r\n  INNER JOIN dim_trips trips ON stop_times.trip_id = trips.trip_id\r\nWHERE\r\n  stop_times.operation_day_date BETWEEN '${__from:date:YYYY-MM-DD}' :: DATE\r\n  AND '${__to:date:YYYY-MM-DD}' :: DATE\r\n  AND stop_times.instance_id IN (${instance:sqlstring})\r\n  AND stop_times.act_arrival_time IS NOT NULL\r\n  AND stops.stop_lat <> 0.0\r\n  AND stops.stop_lon <> 0.0\r\nGROUP BY\r\n  stops.stop_lat,\r\n  stops.stop_lon,\r\n  stop_times.stop_id",
          "refId": "MeanDelayQuery",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Pünktlichkeit Ø",
