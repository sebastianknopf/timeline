      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timeline-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  stops.stop_name AS \"Haltestelle\",\r\n  AVG(\r\n    EXTRACT(\r\n      EPOCH\r\n      FROM\r\n        (\r\n          act_arrival_time - nom_arrival_time\r\n        )\r\n    )\r\n  ) / 60.0 AS \"Abw. Ankunft\",\r\n  AVG(\r\n    EXTRACT(\r\n      EPOCH\r\n      FROM\r\n        (\r\n          act_departure_time - nom_departure_time\r\n        )\r\n    )\r\n  ) / 60.0 AS \"Abw. Abfahrt\",\r\n  COUNT(DISTINCT stop_times.trip_id) AS \"Anz. Soll-Abfahrten\",\r\n  COUNT(DISTINCT stop_times.trip_id) FILTER (\r\n    WHERE\r\n      act_arrival_time IS NOT NULL\r\n      OR act_departure_time IS NOT NULL\r\n  ) AS \"Anz. Ist-Abfahrten\"\r\nFROM\r\n  fact_stop_times stop_times\r\n  INNER JOIN dim_stops stops ON stops.stop_id = stop_times.stop_id\r\n  INNER JOIN dim_trips trips ON trips.trip_id = stop_times.trip_id\r\n  INNER JOIN dim_routes routes ON routes.route_id = trips.route_id\r\nWHERE\r\n  stop_times.operation_day_date BETWEEN '${__from:date:YYYY-MM-DD}' :: DATE\r\n  AND '${__to:date:YYYY-MM-DD}' :: DATE\r\n  AND stop_times.instance_id IN (${instance:sqlstring})\r\n  AND COALESCE(\r\n    trips.concessionaire_name,\r\n    routes.concessionaire_name\r\n  ) IN (${concessionaire:sqlstring})\r\n  AND routes.route_name IN (${route:sqlstring})\r\nGROUP BY\r\n  stops.stop_name\r\nORDER BY\r\n  stops.stop_name",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Ø Abweichung nach Haltestellen",
      "type": "table"
    },
