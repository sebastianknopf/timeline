      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timeline-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  trips.operation_day_date AS \"Datum\",\r\n  AVG(\r\n    GREATEST(\r\n      0,\r\n      100.0 - ABS(\r\n        (\r\n          (\r\n            EXTRACT(\r\n              EPOCH\r\n              FROM\r\n                (\r\n                  act_end_time - act_start_time\r\n                )\r\n            ) - EXTRACT(\r\n              EPOCH\r\n              FROM\r\n                (\r\n                  nom_end_time - nom_start_time\r\n                )\r\n            )\r\n          ) / NULLIF(\r\n            EXTRACT(\r\n              EPOCH\r\n              FROM\r\n                (\r\n                  nom_end_time - nom_start_time\r\n                )\r\n            ),\r\n            0\r\n          )\r\n        ) * 100.0\r\n      )\r\n    )\r\n  ) AS \"Pünktlichkeit\"\r\nFROM\r\n  dim_trips trips\r\n  INNER JOIN dim_routes routes ON routes.route_id = trips.route_id\r\nWHERE\r\n  trips.instance_id IN (${instance:sqlstring})\r\n  AND COALESCE(\r\n    trips.concessionaire_name,\r\n    routes.concessionaire_name\r\n  ) IN (${concessionaire:sqlstring})\r\n  AND routes.route_name IN (${route:sqlstring})\r\n  AND act_start_time IS NOT NULL\r\n  AND act_end_time IS NOT NULL\r\nGROUP BY\r\n  trips.operation_day_date\r\nORDER BY\r\n  trips.operation_day_date;",
          "refId": "A",
