        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timeline-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  SUM(num_entities) AS \"Anz. Datensätze\",\r\n  SUM(age_seconds) AS \"Rückschauzeit\",\r\n  \"timestamp\" AS \"Zeitstempel\"\r\nFROM\r\n  fact_requests requests\r\nWHERE\r\n  $__timeFilter(timestamp)\r\n  AND requests.instance_id IN (${instance:sqlstring})\r\n  AND requests.pipeline_id IN (${pipeline:sqlstring})\r\nGROUP BY\r\n  \"timestamp\"",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "alias": "\"Anz. Datensätze\"",
                "name": "SUM",
                "parameters": [
                  {
                    "name": "num_entities",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              },
              {
                "alias": "\"Rückschauzeit\"",
                "name": "SUM",
                "parameters": [
                  {
                    "name": "age_seconds",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              },
              {
                "alias": "\"Zeitstempel\"",
                "parameters": [
                  {
                    "name": "\"timestamp\"",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "name": "\"timestamp\"",
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "table": "fact_requests"
        }
      ],
