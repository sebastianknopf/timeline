          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  issue_types.code AS \"Typ\",\r\n  COALESCE(\r\n    quality_issues.operator_id,\r\n    quality_issues.concessionaire_id\r\n  ) AS \"Lieferant\",\r\n  COUNT(quality_issues.issue_id) AS \"Anzahl\"\r\nFROM\r\n  fact_quality_issues quality_issues\r\n  INNER JOIN dim_issue_types issue_types ON quality_issues.issue_type_id = issue_types.id\r\nWHERE\r\n  $__timeFilter(timestamp)\r\n  AND quality_issues.instance_id IN (${instance:sqlstring})\r\n  AND quality_issues.pipeline_id IN (${pipeline:sqlstring})\r\n  AND (\r\n    '${deliverer}' = ''\r\n    OR COALESCE(\r\n      quality_issues.concessionaire_id,\r\n      quality_issues.operator_id\r\n    ) = ANY(string_to_array('${deliverer}', ','))\r\n  )\r\nGROUP BY\r\n  issue_types.code,\r\n  COALESCE(\r\n    quality_issues.operator_id,\r\n    quality_issues.concessionaire_id\r\n  )",
          "refId": "A",
          "sql": {
