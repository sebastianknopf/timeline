          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\r\n  pipeline_id AS \"Quelle\",\r\n  ROUND(100.0 * MAX(loaded_direct_trip_count) / NULLIF(MAX(num_entities), 0), 2) AS \"DIRECT\",\r\n  ROUND(100.0 * MAX(loaded_matched_trip_count) / NULLIF(MAX(num_entities), 0), 2) AS \"MATCHING\"\r\nFROM\r\n  fact_requests requests\r\nWHERE\r\n  $__timeFilter(timestamp)\r\n  AND requests.instance_id IN (${instance:sqlstring})\r\n  AND requests.pipeline_id IN (${pipeline:sqlstring})\r\nGROUP BY\r\n  pipeline_id",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "alias": "\"Direct\"",
                "name": "MAX",
                "parameters": [
                  {
                    "name": "loaded_direct_trip_count",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              },
              {
                "alias": "\"Matching\"",
                "name": "MAX",
                "parameters": [
                  {
                    "name": "loaded_matched_trip_count",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              },
              {
                "alias": "\"Quelle\"",
                "parameters": [
                  {
                    "name": "pipeline_id",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "name": "pipeline_id",
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "table": "fact_requests"
        }
      ],
