instance:
  - id: "demo-tenant"
    pipeline:
      - id: "nominal-main"
        name: "gtfs"
        type: "nominal"
        cron: "0 2 * * *"
        # Optional; defaults to "schedule"
        policy: "startupAndSchedule"
        endpoint: "https://api.example.com/schedule"
        filter:
          routes:
            - match: "*-route1"
              type: "include"
              mapping:
                stops: "mapping/stops.csv"
                routes: "mapping/routes.csv"
            - match: "*-route2"
              type: "exclude"
              mapping:
                stops: "/etc/mapping/stops2.csv"
                routes: "/etc/mapping/routes2.csv"
        parameters:
          fallback_agency_id: "UNKNOWN-AGENCY"
          fallback_agency_name: "Unknown Agency"
        authentication:
          token: "${NOMINAL_API_TOKEN}"
      - id: "realtime-main"
        name: "gtfsrt-tripupdates"
        type: "realtime"
        cron: "* * * * *"
        policy: "schedule"
        # Optional high-frequency schedule: "*/10 * * * * *" (every 10 seconds)
        endpoint: "https://api.example.com/realtime"
        priority: 0
        filter:
          operators:
            - match: "*-operator1"
              type: "include"
              mapping:
                stops: "mapping/stops.csv"
                routes: "mapping/routes.csv"
            - match: "*-operator2"
              type: "exclude"
              mapping:
                stops: "/etc/mapping/stops2.csv"
                routes: "/etc/mapping/routes2.csv"
        authentication:
          cert: "security/client.crt"
          key: "security/client.key"
        timezone: "Europe/Berlin"
        # Timezone must match the corresponding GTFS feed in GTFS-RT timezone
    export:
      - id: "daily-trip-export"
        name: "timeline-export"
        cron: "0 3 * * *"
        period:
          from: -1
          to: 0
        processing:
          # Optional: maps to PROCESSOR_EXPORT_DIR on the host via docker-compose volume.
          # If omitted, files are stored only inside the container.
          directory: "/var/data/exports"