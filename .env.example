# Compose project name used for Docker labels and Promtail filtering.
COMPOSE_PROJECT_NAME=timeline

# PostgreSQL connection settings.
POSTGRES_DB=timeline
POSTGRES_USER=timeline
POSTGRES_PASSWORD=change_me

# SQLAlchemy/psycopg connection URL used by processor and Alembic.
PROCESSOR_DATABASE_URL=postgresql+psycopg://timeline:change_me@db:5432/timeline

# Host directory mounted as /etc/mapping inside processor.
# Default is current project directory if unset in compose.
PROCESSOR_MAPPING_DIR=.

# IANA timezone used by processor scheduling and GTFS operation-day/timestamp conversion.
PROCESSOR_TIMEZONE=UTC

# Grafana administrator credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Grafana UI defaults.
GRAFANA_DEFAULT_LANGUAGE=de-DE
GRAFANA_DEFAULT_THEME=light

# Profile usage:
# - docker compose --profile grafana up --build
#   Starts central Grafana with full provisioning.
# - docker compose --profile monitoring up --build
#   Starts technical monitoring containers only (Loki + Promtail).
# - docker compose --profile grafana --profile monitoring up --build
#   Enables Grafana log queries against Loki.
